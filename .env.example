# Copy to .env (local) or paste into your host's environment settings.
# Never commit the real values — .env is git-ignored.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Public site URL (sitemap, robots, structured data). Leave blank to use the default.
NEXT_PUBLIC_SITE_URL=https://ciputracorp.com

# --- Demo data --------------------------------------------------------------
# Set to false on a live deployment so the demo logins and sample orders are not created.
SEED_DEMO_DATA=true

# --- Payments (leave blank to run the built-in test-card simulation) ---------
# NEXT_PUBLIC_* values are baked in at BUILD time, so set them before building.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional integrations (each falls back to a built-in simulation) -------
TAXJAR_API_KEY=
EASYPOST_API_KEY=
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, e.g. info@ciputracorp.com
RESEND_FROM=
