# Copy to .env (local) or paste into your host's environment settings.
# Never commit the real values — .env is git-ignored.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Public site URL (sitemap, robots, structured data). Leave blank to use the default.
NEXT_PUBLIC_SITE_URL=https://ciputracorp.com

# --- Demo data --------------------------------------------------------------
# Unset = demo only outside production (NODE_ENV !== "production").
# A live deployment MUST set this to false: no demo logins, no sample orders.
SEED_DEMO_DATA=false

# --- Payments (leave blank to run the built-in test-card simulation) ---------
# NEXT_PUBLIC_* values are baked in at BUILD time, so set them before building.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks → endpoint https://<domain>/api/stripe/webhook with events
# payment_intent.amount_capturable_updated, payment_intent.succeeded, payment_intent.canceled.
STRIPE_WEBHOOK_SECRET=

# --- Scheduled maintenance (vercel.json cron) --------------------------------
# Any long random string. Vercel sends it as "Authorization: Bearer <value>" to /api/cron/maintenance.
CRON_SECRET=

# --- Optional integrations (each falls back to a built-in simulation) -------
# Neon/Vercel: connections per serverless instance (default 5).
# Use the pooled Neon connection string (host contains "-pooler") with sslmode=require.
# DATABASE_POOL_MAX=5

TAXJAR_API_KEY=
EASYPOST_API_KEY=
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, e.g. info@ciputracorp.com
RESEND_FROM=
