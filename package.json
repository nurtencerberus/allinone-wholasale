{
  "name": "ciputra-corp-store",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:export": "drizzle-kit export --dialect=postgresql --schema=./src/db/schema.ts > db/schema.sql",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.21"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
